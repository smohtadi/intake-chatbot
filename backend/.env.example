NODE_ENV=development
PORT=3000
# Local Postgres from the root docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/clinic
DEMO_USERNAME=demo
# Generate with: npm run hash-password -- <password>
DEMO_PASSWORD_HASH=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5-lite
FRONT_DESK_PHONE=(604) 555-0100
# Set in production to serve the frontend build, e.g. ../frontend/dist
STATIC_DIR=
# Number of reverse proxies in front of the app (1 on Render), so rate limiting sees client IPs
TRUST_PROXY=0
